{
	"$schema": "https://biomejs.dev/schemas/2.6.8/schema.json",
	"files": {
		"includes": [
			"**",
			"!**/node_modules",
			"!**/.agents",
			"!**/migrations",
			"!**/docs",
			"!**/scripts/eval",
			"!**/src/api/admin/ui.ts",
			"!**/src/api/admin/starmap.ts"
		]
	},
	"assist": { "actions": { "source": { "organizeImports": "off" } } },
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"performance": {
				"noDelete": "off"
			},
			"style": {
				"noNonNullAssertion": "warn"
			}
		}
	},
	"overrides": [
		{
			"includes": ["**/tests/**"],
			"linter": {
				"rules": {
					"suspicious": {
						"noExplicitAny": "off"
					}
				}
			}
		}
	]
}
